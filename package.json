{
  "name": "usopoke",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "deploy": "npm run build && wrangler deploy",
    "dev": "react-router dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "vite preview",
    "typecheck": "react-router typegen && tsc",
    "typegen": "wrangler types --strict-vars false",
    "preview": "npm run build && npm run start",
    "cf-typegen": "npm run typegen",
    "supabase-typegen": "supabase gen types typescript --project-id \"bppgbaxsswwmvfxabgmk\" > ./app/types/supabase.ts",
    "supabase-db:pull": "supabase db pull",
    "supabase-db:pull-auth-storage": "supabase db pull --schema auth, storage",
    "supabase-db:push": "supabase db push",
    "supabase-db:commit": "supabase db commit"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@react-spring/web": "^10.1.2",
    "@supabase/auth-helpers-remix": "^0.4.0",
    "@supabase/supabase-js": "2.45.4",
    "cf-workers-og": "3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "isbot": "^5",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.54.0",
    "react-rewards": "2.1.0",
    "react-router": "8.5.1",
    "react-textarea-autosize": "^8.5.6",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.1",
    "@eslint/js": "^9.39.5",
    "@react-router/dev": "8.5.1",
    "@types/node": "^22",
    "@types/react": "^19.2",
    "@types/react-dom": "^19.2",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4",
    "eslint-plugin-import": "^2.32",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "wrangler": "4.161.0"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
